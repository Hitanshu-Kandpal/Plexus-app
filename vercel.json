{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/index.js"
    },
    {
      "source": "/auth/google",
      "destination": "/server/index.js"
    },
    {
      "source": "/auth/facebook",
      "destination": "/server/index.js"
    },
    {
      "source": "/auth/refresh",
      "destination": "/server/index.js"
    },
    {
      "source": "/auth/logout",
      "destination": "/server/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/client/build/index.html"
    }
  ]
}
